# ─── Backend (FastAPI) ────────────────────────────────────────
# Прод. база PostgreSQL (по SPEC):
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/finance
# Dev-фолбэк (по умолчанию):
DATABASE_URL=sqlite+aiosqlite:///./finance.db

# БЕЗОПАСНОСТЬ — в проде задайте длинный случайный ключ!
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS / фронтенд
FRONTEND_ORIGIN=http://localhost:5173
RESET_PASSWORD_URL=http://localhost:5173/reset-password
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ─── Frontend (Vite) ───────────────────────────────────────────
# URL бэкенд-API (если фронтенд и бэкенд на разных хостах)
# VITE_API_URL=http://localhost:8080
